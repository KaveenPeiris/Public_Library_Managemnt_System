<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="780.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Members.AddMemberController">

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Pane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #F97316; -fx-background-radius: 8px;" />
                        <Label text="Panadura Library" textFill="#1E293B">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                    </children>
                    <VBox.margin><Insets bottom="25.0" /></VBox.margin>
                </HBox>

                <Label text="MAIN MENU" textFill="#94A3B8">
                    <font><Font name="System Bold" size="10.0" /></font>
                    <VBox.margin><Insets bottom="8.0" left="10.0" /></VBox.margin>
                </Label>

                <VBox spacing="6.0">
                    <children>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" styleClass="sidebar-btn" text="📊 Dashboard / Add Book" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" styleClass="sidebar-btn" text="📚 Catalog / View Books" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" styleClass="sidebar-btn-active" text="👤 Add New Member" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" styleClass="sidebar-btn" text="👥 View Members" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" styleClass="sidebar-btn" text="⚙️ Manage Members" />
                    </children>
                </VBox>

                <Label text="TRANSACTIONS" textFill="#94A3B8">
                    <font><Font name="System Bold" size="10.0" /></font>
                    <VBox.margin><Insets bottom="8.0" left="10.0" top="15.0" /></VBox.margin>
                </Label>

                <VBox spacing="6.0">
                    <children>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" styleClass="sidebar-btn" text="📤 Issue Books" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" styleClass="sidebar-btn" text="📥 Return Books" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" styleClass="sidebar-btn" text="📋 Borrowing History" />
                    </children>
                </VBox>

                <Pane VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 8px; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;">
                    <children>
                        <Circle fill="#F97316" radius="15.0" />
                        <VBox>
                            <children>
                                <Label text="Nadia Karim" textFill="#1E293B"><font><Font name="System Bold" size="12.0" /></font></Label>
                                <Label text="Head Librarian" textFill="#64748B"><font><Font size="10.0" /></font></Label>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                </HBox>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-cursor: hand; -fx-background-radius: 6px; -fx-padding: 0 12; -fx-font-weight: bold;" text="🚪 Log Out" />
            </children>
        </VBox>
    </left>

    <!-- Center Form Area -->
    <center>
        <BorderPane style="-fx-background-color: #F8FAFC;">
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="65.0" styleClass="header-bar">
                    <children>
                        <Label text="Register New Member" textFill="#1E293B">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" prefHeight="32.0" prefWidth="90.0" styleClass="button-secondary" text="← Back" />
                    </children>
                </HBox>
            </top>

            <center>
                <VBox spacing="20.0">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>
                        <VBox spacing="25.0" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Member Personal Information" textFill="#1E293B">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                </Label>

                                <GridPane hgap="30.0" vgap="20.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="380.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="380.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label text="Member ID" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtMemberId" promptText="Enter Member ID..." />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label text="Full Name" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtFullName" promptText="Enter Full Name..." />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Email Address" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtEmail" promptText="Enter Email..." />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Phone Number" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtPhone" promptText="Enter Phone Number..." />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <children>
                                                <Label text="Physical Address" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtAddress" promptText="Enter Address..." />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <Pane VBox.vgrow="ALWAYS" />

                                <HBox spacing="15.0">
                                    <children>
                                        <Button fx:id="btnSaveMember" mnemonicParsing="false" prefHeight="40.0" prefWidth="160.0" styleClass="button-success" text="Register Member" />
                                        <Button fx:id="btnClear" mnemonicParsing="false" prefHeight="40.0" prefWidth="120.0" styleClass="button-secondary" text="Clear" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>