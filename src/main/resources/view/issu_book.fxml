<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="780.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Books.IssuBookPageController">

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <!-- Brand / Logo Area -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Pane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #F97316; -fx-background-radius: 8px;" />
                        <Label text="Panadura Library" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="25.0" />
                    </VBox.margin>
                </HBox>

                <Label text="MAIN MENU" textFill="#94A3B8">
                    <font>
                        <Font name="System Bold" size="10.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="8.0" left="10.0" />
                    </VBox.margin>
                </Label>

                <!-- Navigation Buttons -->
                <VBox spacing="6.0">
                    <children>
                        <Button fx:id="btnAddBookNav" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAddBookNavOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="📊 Dashboard / Add Book" />
                        <Button fx:id="btnViewBook" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnViewBookOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="📚 Catalog / View Books" />
                        <Button fx:id="btnAddMember" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="👤 Add Member" />
                        <Button fx:id="btnViewMembers" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnViewMembersOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="👥 View Members" />
                        <Button fx:id="btnManagerMember" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnManageMemberOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="⚙️ Manage Members" />
                    </children>
                </VBox>

                <Label text="TRANSACTIONS" textFill="#94A3B8">
                    <font>
                        <Font name="System Bold" size="10.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="8.0" left="10.0" top="15.0" />
                    </VBox.margin>
                </Label>

                <VBox spacing="6.0">
                    <children>
                        <Button fx:id="btnIssuBooks" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnIssuBooksOnAction" prefHeight="36.0" styleClass="sidebar-btn-active" text="📤 Issue Books" />
                        <Button fx:id="btnReturnBook" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="📥 Return Books" />
                        <Button fx:id="btnBrrowingHistory" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnBrrowingHistoryOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="📋 Borrowing History" />
                    </children>
                </VBox>

                <Pane VBox.vgrow="ALWAYS" />

                <!-- Profile Badge -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 8px; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;">
                    <children>
                        <Circle radius="15.0" fill="#F97316" />
                        <VBox>
                            <children>
                                <Label text="Nadia Karim" textFill="#1E293B">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <Label text="Head Librarian" textFill="#64748B">
                                    <font>
                                        <Font size="10.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </HBox>

                <!-- Logout Button -->
                <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="36.0" style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-cursor: hand; -fx-background-radius: 6px; -fx-padding: 0 12; -fx-font-weight: bold;" text="🚪 Log Out" />
            </children>
        </VBox>
    </left>

    <!-- Center Area -->
    <center>
        <BorderPane style="-fx-background-color: #F8FAFC;" BorderPane.alignment="CENTER">
            <!-- Top Header Bar -->
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="65.0" styleClass="header-bar" BorderPane.alignment="CENTER">
                    <children>
                        <Label text="Issue Book to Member" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPrevious" mnemonicParsing="false" onAction="#btnPreviousOnAction" prefHeight="32.0" prefWidth="90.0" styleClass="button-secondary" text="← Back" />
                    </children>
                </HBox>
            </top>

            <center>
                <VBox spacing="20.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>
                        <!-- Form Container Card -->
                        <VBox spacing="25.0" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Book Issuance Details" textFill="#1E293B">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Label>

                                <!-- Form Fields Grid -->
                                <GridPane hgap="30.0" vgap="20.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="350.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="350.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <!-- Select Member -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label text="Select Member" textFill="#475569">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="cmbMember" onAction="#cmbMemebrOnAction" prefHeight="36.0" prefWidth="380.0" promptText="Select Member (ID &amp; Name)" />
                                            </children>
                                        </VBox>

                                        <!-- Select Book -->
                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label text="Select Book" textFill="#475569">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="cmbBook" onAction="#cmbBookOnAction" prefHeight="36.0" prefWidth="380.0" promptText="Select Book (ID &amp; Title)" />
                                            </children>
                                        </VBox>

                                        <!-- Issue Date -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Issue Date" textFill="#475569">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <DatePicker fx:id="dateIssue" prefHeight="36.0" prefWidth="380.0" />
                                            </children>
                                        </VBox>

                                        <!-- Due Date -->
                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Due Date" textFill="#475569">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <DatePicker fx:id="dateDue" prefHeight="36.0" prefWidth="380.0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <Pane VBox.vgrow="ALWAYS" />

                                <!-- Form Buttons -->
                                <HBox spacing="15.0">
                                    <children>
                                        <Button fx:id="btnIssueBook" mnemonicParsing="false" onAction="#btnIssuBooksOnAction" prefHeight="40.0" prefWidth="160.0" styleClass="button-primary" text="Issue Book" />
                                        <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="40.0" prefWidth="120.0" styleClass="button-secondary" text="Clear" />
                                    </children>
                                    <VBox.margin>
                                        <Insets top="10.0" />
                                    </VBox.margin>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>