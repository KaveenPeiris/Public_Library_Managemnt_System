<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="780.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Books.AddBookPageController">

    <!-- Navbar Sidebar -->
    <left>
        <VBox prefWidth="250.0" style="-fx-background-color: #0F172A; -fx-border-color: #1E293B; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" left="16.0" right="16.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Pane prefHeight="36.0" prefWidth="36.0" style="-fx-background-color: linear-gradient(to bottom right, #F97316, #EA580C); -fx-background-radius: 10px;" />
                        <Label text="Panadura Library" textFill="WHITE"><font><Font name="System Bold" size="15.0" /></font></Label>
                    </children>
                    <VBox.margin><Insets bottom="28.0" /></VBox.margin>
                </HBox>

                <VBox spacing="6.0">
                    <children>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: linear-gradient(to right, #2563EB, #1D4ED8); -fx-text-fill: #FFFFFF; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📊 Add New Book" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #1E293B; -fx-text-fill: #93C5FD; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📚 Catalog / View Books" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #1E293B; -fx-text-fill: #6EE7B7; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="👤 Add Member" />
                    </children>
                </VBox>
                <Pane VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <BorderPane style="-fx-background-color: #F8FAFC;">
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="65.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 0 30;">
                    <children>
                        <Label text="Add New Book to Catalog" textFill="#0F172A"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" prefHeight="34.0" prefWidth="100.0" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-cursor: hand; -fx-background-radius: 8px; -fx-font-weight: bold;" text="← Back" />
                    </children>
                </HBox>
            </top>

            <center>
                <VBox spacing="20.0">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                    <children>
                        <VBox spacing="25.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 14px; -fx-padding: 28; -fx-border-color: #E2E8F0; -fx-border-radius: 14px; -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.04), 16, 0, 0, 4);" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Book Information" textFill="#0F172A"><font><Font name="System Bold" size="15.0" /></font></Label>

                                <GridPane hgap="30.0" vgap="20.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="380.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="380.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <!-- Book ID with Auto Gen Button -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label text="Book ID / ISBN" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <TextField fx:id="txtBookId" promptText="Auto-generated ID..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8 12;" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="btnAutoGenerate" mnemonicParsing="false" onAction="#btnAddOnAction" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: linear-gradient(to right, #8B5CF6, #7C3AED); -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(139,92,246,0.3), 8, 0, 0, 3);" text="⚡ Auto-Gen" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label text="Book Title" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtTitle" promptText="Enter Book Title..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8 12;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Author Name" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtAuthor" promptText="Enter Author Name..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8 12;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Category" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <ComboBox fx:id="cmbCategory" prefHeight="36.0" prefWidth="400.0" promptText="Select Category" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <children>
                                                <Label text="Publish Year" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtYear" promptText="e.g. 2024" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8 12;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <children>
                                                <Label text="Quantity" textFill="#475569"><font><Font name="System Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtQuantity" promptText="e.g. 5" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8 12;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <Pane VBox.vgrow="ALWAYS" />

                                <HBox spacing="15.0">
                                    <children>
                                        <Button fx:id="btnSaveBook" mnemonicParsing="false" prefHeight="42.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to right, #059669, #047857); -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(5,150,105,0.3), 10, 0, 0, 4);" text="Save Book" />
                                        <Button fx:id="btnClear" mnemonicParsing="false" prefHeight="42.0" prefWidth="130.0" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 8px;" text="Clear" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>