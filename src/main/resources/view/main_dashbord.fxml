                                    </children>
                                </VBox>

                                <VBox prefHeight="120.0" prefWidth="285.0" style="-fx-background-color: linear-gradient(to bottom right, #059669, #047857); -fx-background-radius: 14px; -fx-padding: 22; -fx-effect: dropshadow(three-pass-box, rgba(5, 150, 105, 0.35), 18, 0, 0, 6);" HBox.hgrow="ALWAYS">
                                    <children>
