                                    </children>
                                </VBox>

                                <VBox prefHeight="120.0" prefWidth="285.0" style="-fx-background-color: linear-gradient(to bottom right, #2563EB, #1D4ED8); -fx-background-radius: 14px; -fx-padding: 22; -fx-effect: dropshadow(three-pass-box, rgba(37, 99, 235, 0.35), 18, 0, 0, 6);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Borrowed Books" textFill="WHITE"><font><Font name="System Bold" size="13.0" /></font></Label>
