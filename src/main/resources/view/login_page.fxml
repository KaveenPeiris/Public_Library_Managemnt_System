<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Login.LoginPageController">
    <children>
        <!-- Left Side: Charcoal Dark Gray Background -->
        <AnchorPane prefHeight="600.0" prefWidth="400.0" style="-fx-background-color: #1F2937;">
            <children>
                <VBox alignment="TOP_CENTER" layoutX="30.0" layoutY="50.0" prefWidth="340.0" spacing="10.0">
                    <children>
                        <Label text="Public Library Of Panadura" textFill="WHITE" wrapText="true">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Library Management System" textFill="#9CA3AF">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <ImageView fx:id="imgLibrary" fitHeight="340.0" fitWidth="340.0" pickOnBounds="true" preserveRatio="true">
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                        </ImageView>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <!-- Right Side: Login Form -->
        <AnchorPane layoutX="400.0" prefHeight="600.0" prefWidth="450.0" style="-fx-background-color: #FFFFFF;">
            <children>
                <VBox layoutX="50.0" layoutY="100.0" prefWidth="350.0" spacing="20.0">
                    <children>
                        <Label text="Welcome to the Library" textFill="#1F2937">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>

                        <!-- Username Field Group -->
                        <VBox spacing="6.0">
                            <children>
                                <Label text="User Name" textFill="#4B5563">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtUsername" promptText="Enter Your User Name" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #D1D5DB; -fx-padding: 10; -fx-background-color: #FFFFFF; -fx-text-fill: #1F2937;" />
                            </children>
                        </VBox>

                        <!-- Password Field Group -->
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Password" textFill="#4B5563">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtPassword" onAction="#txtPasswordOnAction" promptText="Enter Your Password" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #D1D5DB; -fx-padding: 10; -fx-background-color: #FFFFFF; -fx-text-fill: #1F2937;" />
                            </children>
                        </VBox>

                        <!-- Forgot Password Link -->
                        <AnchorPane prefHeight="20.0">
                            <children>
                                <Hyperlink layoutX="230.0" text="Forgot password?" textFill="#1F2937" style="-fx-underline: false;">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Hyperlink>
                            </children>
                        </AnchorPane>

                        <!-- Login Button -->
                        <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#btnLoginbutton" prefHeight="45.0" prefWidth="350.0" style="-fx-background-color: #2563EB; -fx-text-fill: WHITE; -fx-background-radius: 6; -fx-cursor: hand;" text="Login">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>