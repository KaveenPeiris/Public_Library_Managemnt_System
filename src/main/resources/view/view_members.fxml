                    <children>
                        <!-- Main Content Card Container -->
                        <VBox spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 14px; -fx-padding: 28; -fx-border-color: #E2E8F0; -fx-border-radius: 14px; -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.04), 16, 0, 0, 4);" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Search Bar -->
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label text="Search Members:" textFill="#475569">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="searchField" onAction="#searchFieldOnAction" prefHeight="38.0" prefWidth="320.0" promptText="Search by name, email, phone..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 6 12;" />
                                    </children>
                                </HBox>

                                <!-- Members TableView -->
                                <TableView fx:id="memberTable" style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMemberId" prefWidth="120.0" text="Member ID" />
                                        <TableColumn fx:id="colFullName" prefWidth="220.0" text="Full Name" />
                                        <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email Address" />
                                        <TableColumn fx:id="colPhone" prefWidth="150.0" text="Phone Number" />
                                        <TableColumn fx:id="colAddress" prefWidth="230.0" text="Address" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <!-- Action Buttons (Update & Delete) -->
                                <HBox spacing="15.0">
                                    <children>
                                        <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="42.0" prefWidth="160.0" style="-fx-background-color: linear-gradient(to right, #0284C7, #0369A1); -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(2,132,199,0.3), 10, 0, 0, 4);" text="Update Member" />
                                        <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="42.0" prefWidth="160.0" style="-fx-background-color: linear-gradient(to right, #E11D48, #BE123C); -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(225,29,72,0.3), 10, 0, 0, 4);" text="Delete Member" />
                                    </children>
