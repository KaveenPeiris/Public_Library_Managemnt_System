                        <Button fx:id="btnReturnBooks" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnReturnBooksOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #6EE7B7; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📥 Return Books" />
                        <Button fx:id="btnBorrowingHistory" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnBorrowingHistoryOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #F472B6; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📋 Borrowing History" />
