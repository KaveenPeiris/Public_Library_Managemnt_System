<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="780.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Books.BrrowingHistoryPageController">

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <!-- Brand / Logo Area -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Pane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #F97316; -fx-background-radius: 8px;" />
                        <Label text="Panadura Library" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="25.0" />
                    </VBox.margin>
                </HBox>

                <Label text="MAIN MENU" textFill="#94A3B8">
                    <font>
                        <Font name="System Bold" size="10.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="8.0" left="10.0" />
                    </VBox.margin>
                </Label>

                <!-- Navigation Buttons -->
                <VBox spacing="6.0">
                    <children>
                        <Button fx:id="btnAddBookNav" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAddBookNavOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="📊 Dashboard / Add Book" />
                        <Button fx:id="btnViewBook" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnViewBookOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="📚 Catalog / View Books" />
                        <Button fx:id="btnAddMember" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="👤 Add Member" />
                        <Button fx:id="btnViewMembers" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnViewMembersOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="👥 View Members" />
                        <Button fx:id="btnManageMember" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnManageMemberOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="⚙️ Manage Members" />
                    </children>
                </VBox>

                <Label text="TRANSACTIONS" textFill="#94A3B8">
                    <font>
                        <Font name="System Bold" size="10.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="8.0" left="10.0" top="15.0" />
                    </VBox.margin>
                </Label>

                <VBox spacing="6.0">
                    <children>
                        <Button fx:id="btnIssueBook" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="📤 Issue Books" />
                        <Button fx:id="btnReturnBook" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="36.0" styleClass="sidebar-btn" text="📥 Return Books" />
                        <Button fx:id="btnBrrowingHistory" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnBrrowingHistoryOnAction" prefHeight="36.0" styleClass="sidebar-btn-active" text="📋 Borrowing History" />
                    </children>
                </VBox>

                <Pane VBox.vgrow="ALWAYS" />

                <!-- Profile Badge -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 8px; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;">
                    <children>
                        <Circle radius="15.0" fill="#F97316" />
                        <VBox>
                            <children>
                                <Label text="Nadia Karim" textFill="#1E293B">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <Label text="Head Librarian" textFill="#64748B">
                                    <font>
                                        <Font size="10.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </HBox>

                <!-- Logout Button -->
                <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="36.0" style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-cursor: hand; -fx-background-radius: 6px; -fx-padding: 0 12; -fx-font-weight: bold;" text="🚪 Log Out" />
            </children>
        </VBox>
    </left>

    <!-- Center Main Body Area -->
    <center>
        <BorderPane style="-fx-background-color: #F8FAFC;" BorderPane.alignment="CENTER">
            <!-- Top Header Bar -->
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="65.0" styleClass="header-bar">
                    <children>
                        <Label text="Borrowing History Records" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPrevious" mnemonicParsing="false" onAction="#btnPreviousOnAction" prefHeight="32.0" prefWidth="90.0" styleClass="button-secondary" text="← Back" />
                    </children>
                </HBox>
            </top>

            <center>
                <VBox spacing="20.0">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>
                        <!-- Main Content Card Container -->
                        <VBox spacing="20.0" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Filter and Search Bar -->
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label text="Status Filter:" textFill="#475569">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="statusComboBox" prefHeight="36.0" prefWidth="180.0" promptText="All Statuses" />

                                        <Pane HBox.hgrow="ALWAYS" />

                                        <TextField fx:id="searchField" prefHeight="36.0" prefWidth="300.0" promptText="Search Member ID or Book Title..." />
                                    </children>
                                </HBox>

                                <!-- Borrowing History TableView -->
                                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMemberId" prefWidth="140.0" text="Member ID" />
                                        <TableColumn fx:id="colBookTitle" prefWidth="310.0" text="Book Title" />
                                        <TableColumn fx:id="colIssueDate" prefWidth="130.0" text="Issue Date" />
                                        <TableColumn fx:id="colDueDate" prefWidth="130.0" text="Due Date" />
                                        <TableColumn fx:id="colReturnDate" prefWidth="130.0" text="Return Date" />
                                        <TableColumn fx:id="colStatus" prefWidth="130.0" text="Status" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>