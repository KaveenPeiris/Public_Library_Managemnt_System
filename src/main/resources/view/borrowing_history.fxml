<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="780.0" prefWidth="1280.0" style="-fx-background-color: #F8FAFC; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Books.BrrowingHistoryPageController">

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox prefWidth="250.0" style="-fx-background-color: #0F172A; -fx-border-color: #1E293B; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="16.0" right="16.0" top="20.0" />
            </padding>
            <children>
                <!-- Brand / Logo Area -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Pane prefHeight="36.0" prefWidth="36.0" style="-fx-background-color: linear-gradient(to bottom right, #F97316, #EA580C); -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(249,115,22,0.4), 10, 0, 0, 4);" />
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Panadura Library" textFill="WHITE">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                </Label>
                                <Label text="Pro Enterprise Edition" textFill="#94A3B8">
                                    <font><Font size="10.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="24.0" />
                    </VBox.margin>
                </HBox>

                <Label text="MAIN MENU" textFill="#64748B">
                    <font><Font name="System Bold" size="10.0" /></font>
                    <VBox.margin><Insets bottom="6.0" left="10.0" /></VBox.margin>
                </Label>

                <!-- Navigation Buttons -->
                <VBox spacing="5.0">
                    <children>
                        <Button fx:id="btnAddBookNav" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAddBookNavOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #93C5FD; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📊 Add Book" />
                        <Button fx:id="btnViewBook" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnViewBookOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #93C5FD; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📚 Catalog / View Books" />
                        <Button fx:id="btnAddMember" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #6EE7B7; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="👤 Add Member" />
                        <Button fx:id="btnViewMembers" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnViewMembersOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #C084FC; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="👥 View Members" />
                        <Button fx:id="btnManageMember" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnManageMemberOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #FDE047; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="⚙️ Manage Members" />
                    </children>
                </VBox>

                <Label text="TRANSACTIONS" textFill="#64748B">
                    <font><Font name="System Bold" size="10.0" /></font>
                    <VBox.margin><Insets bottom="6.0" left="10.0" top="15.0" /></VBox.margin>
                </Label>

                <VBox spacing="5.0">
                    <children>
                        <Button fx:id="btnIssueBook" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #FDBA74; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📤 Issue Books" />
                        <Button fx:id="btnReturnBook" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="38.0" style="-fx-background-color: #1E293B; -fx-text-fill: #6EE7B7; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📥 Return Books" />
                        <Button fx:id="btnBrrowingHistory" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnBrrowingHistoryOnAction" prefHeight="38.0" style="-fx-background-color: linear-gradient(to right, #EC4899, #DB2777); -fx-text-fill: #FFFFFF; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="📋 Borrowing History" />
                    </children>
                </VBox>

                <Pane VBox.vgrow="ALWAYS" />

                <!-- Profile Badge -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #1E293B; -fx-padding: 10; -fx-background-radius: 10px; -fx-border-color: #334155; -fx-border-radius: 10px;">
                    <children>
                        <Circle fill="#F97316" radius="16.0" />
                        <VBox>
                            <children>
                                <Label text="Nadia Karim" textFill="WHITE">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <Label text="Head Librarian" textFill="#94A3B8">
                                    <font><Font size="10.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                </HBox>

                <!-- Logout Button -->
                <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="38.0" style="-fx-background-color: #312E81; -fx-text-fill: #FCA5A5; -fx-cursor: hand; -fx-background-radius: 8px; -fx-padding: 0 14; -fx-font-weight: bold;" text="🚪 Log Out" />
            </children>
        </VBox>
    </left>

    <!-- Center Main Body Area -->
    <center>
        <BorderPane style="-fx-background-color: #F8FAFC;" BorderPane.alignment="CENTER">
            <!-- Top Header Bar -->
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 0 30;">
                    <children>
                        <Label text="Borrowing History Records" textFill="#0F172A">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPrevious" mnemonicParsing="false" onAction="#btnPreviousOnAction" prefHeight="34.0" prefWidth="100.0" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-cursor: hand; -fx-background-radius: 8px; -fx-font-weight: bold;" text="← Back" />
                    </children>
                </HBox>
            </top>

            <center>
                <VBox spacing="20.0">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>
                        <!-- Main Content Card Container -->
                        <VBox spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 14px; -fx-padding: 28; -fx-border-color: #E2E8F0; -fx-border-radius: 14px; -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.04), 16, 0, 0, 4);" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Filter and Search Bar -->
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label text="Status Filter:" textFill="#475569">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="statusComboBox" prefHeight="36.0" prefWidth="180.0" promptText="All Statuses" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px;" />

                                        <Pane HBox.hgrow="ALWAYS" />

                                        <TextField fx:id="searchField" prefHeight="36.0" prefWidth="300.0" promptText="Search Member ID or Book Title..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 6 12;" />
                                    </children>
                                </HBox>

                                <!-- Borrowing History TableView -->
                                <TableView fx:id="historyTable" style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMemberId" prefWidth="140.0" text="Member ID" />
                                        <TableColumn fx:id="colBookTitle" prefWidth="310.0" text="Book Title" />
                                        <TableColumn fx:id="colIssueDate" prefWidth="130.0" text="Issue Date" />
                                        <TableColumn fx:id="colDueDate" prefWidth="130.0" text="Due Date" />
                                        <TableColumn fx:id="colReturnDate" prefWidth="130.0" text="Return Date" />
                                        <TableColumn fx:id="colStatus" prefWidth="130.0" text="Status" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>